{
  "mcpServers": {
    "github": {
      "transport": {
        "type": "streamableHttp",
        "url": "https://api.githubcopilot.com/mcp/"
      }
    },
    "aider_repo_manager": {
      "command": "uvx",
      "args": ["aider", "--message", "Iniciando modo de analise MCP"]
    },
    "rea-agents": {
      "command": "rea-agents.cmd",
      "args": ["mcp"]
    },
    "scrapling_tools": {
      "command": "uv",
      "args": ["run", "src/scrapling_server.py"]
    }
  }
}
